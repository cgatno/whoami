---
// The landing hero: a full-viewport contour map that Seattle's predicted
// tide floods valley by valley. The code is in src/hero/.
//
// The name and tagline are ordinary text. Once the map is up, the canvas
// draws them too, so their ink can change where the water crosses them.
// Without WebGL, or if the canvas fails, the map stays hidden and the
// ordinary text shows on the page background.
interface Props {
	title: string;
	lead: string;
}

const { title, lead } = Astro.props;
---

<canvas id="hero" aria-hidden="true"></canvas>

<div class="stage">
	<p class="eyebrow" data-hero-text="small">Seattle tide · <span id="tide-readout">…</span></p>
	<h1 data-hero-text="display">{title}</h1>
	<p class="lead" data-hero-text="lead">{lead}</p>
</div>

<script>
	import "../hero/main";
</script>

<style>
	#hero {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	/* An undrawn canvas is black. Keep it transparent until the first frame,
	   then fade the map in. The duration matches FADE_MS in the script. */
	#hero {
		opacity: 0;
		transition: opacity 400ms ease-out;
	}

	#hero.ready {
		opacity: 1;
	}

	.stage {
		position: relative;
		max-width: 64rem;
		margin-inline: auto;
		padding: var(--space-8) var(--space-4) 0;
	}

	/* While the canvas draws the text, the real text stays in place for
	   screen readers, selection and search, but is not painted. If the
	   visitor has forced colors on, leave their text alone. */
	.stage.on-canvas [data-hero-text] {
		color: transparent;
	}

	.stage.on-canvas [data-hero-text]::selection {
		color: transparent;
	}

	@media (forced-colors: active) {
		.stage.on-canvas [data-hero-text] {
			color: CanvasText;
		}
	}

	.eyebrow {
		font-family: var(--font-ui);
		font-variation-settings: var(--axes-ui);
		font-size: var(--text-meta);
		font-weight: 500;
		color: var(--dim);
		margin-block-end: var(--space-3);
	}

	h1 {
		font-size: var(--text-display);
		line-height: var(--leading-display);
		margin-block-end: var(--space-4);
	}

	.lead {
		font-size: var(--text-lead);
		line-height: var(--leading-lead);
		max-width: var(--measure-narrow);
	}
</style>

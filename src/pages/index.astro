---
import Base from "../layouts/Base.astro";
---

<Base title="Christian Gaetano">
	<main class="flow">
		<h1>Christian Gaetano</h1>
		<p class="ui">Recursive at MONO 0 — interface chrome</p>
		<p>Newsreader carries body copy, with <em>a true italic</em> for emphasis.</p>
		<h2>Familjen Grotesk sets the headings</h2>
		<pre><code>// Recursive at MONO 1 — code
const fonts = ["Familjen Grotesk", "Newsreader", "Recursive"];</code></pre>
	</main>
</Base>

<style>
	main {
		max-width: var(--measure);
		margin-inline: auto;
		padding: var(--space-7) var(--space-3);
	}

	.ui {
		font-family: var(--font-ui);
		font-variation-settings: var(--axes-ui);
		font-size: var(--text-meta);
	}
</style>

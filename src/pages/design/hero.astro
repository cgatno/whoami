---
import Hero from "../../components/Hero.astro";
import Base from "../../layouts/Base.astro";

// Hero lab: the homepage hero with controls for the tide, the canvas text
// and the theme, plus timings. It's a working page under /design, so it's
// excluded from the sitemap.
//
// URL flags, here or on the homepage: ?tide=0..1 pins the tide, ?seed=
// picks another terrain, ?domtext leaves the text to the page, ?bake=cpu
// or ?bake=compare tries the JavaScript terrain bake, and ?coldshaders and
// ?blocking measure shader compiles.
---

<Base title="Hero lab · whoami">
	<meta slot="head" name="robots" content="noindex" />

	<main>
		<Hero title="Christian Gaetano" lead="Software engineer & dabbling designer." />
	</main>

	<div class="controls">
		<div class="group" role="group" aria-label="Tide">
			<button type="button" data-mode="live">Live</button>
			<button type="button" data-mode="lapse">Time-lapse</button>
			<button type="button" data-mode="scrub">Scrub</button>
			<input id="tide-scrub" type="range" min="0" max="1" step="0.001" aria-label="Tide level" />
		</div>
		<label><input id="hero-canvas-text" type="checkbox" checked /> Canvas text</label>
		<button type="button" id="hero-theme">Theme</button>
		<span id="hero-stats"></span>
	</div>
</Base>

<style>
	.controls {
		position: fixed;
		inset: auto var(--space-3) var(--space-3) var(--space-3);
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		align-items: center;
		padding: var(--space-2) var(--space-3);
		font-family: var(--font-ui);
		font-variation-settings: var(--axes-ui);
		font-size: var(--text-meta);
		font-weight: 500;
		background: color-mix(in oklab, var(--ground) 86%, transparent);
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		backdrop-filter: blur(8px);
	}

	.group {
		display: flex;
		gap: var(--space-1);
		align-items: center;
	}

	button {
		padding: var(--space-1) var(--space-2);
		border: 1px solid var(--rule-strong);
		border-radius: var(--radius);
		background: none;
		color: var(--dim);
		cursor: pointer;
	}

	button[aria-pressed="true"] {
		color: var(--ground);
		background: var(--accent);
		border-color: var(--accent);
	}

	label {
		display: flex;
		gap: var(--space-1);
		align-items: center;
		color: var(--dim);
		margin-inline-end: var(--space-1);
	}

	#tide-scrub {
		width: 10rem;
	}

	#hero-stats {
		color: var(--faint);
		font-family: var(--font-code);
		font-variation-settings: var(--axes-code);
		font-size: var(--text-micro);
		margin-inline-start: auto;
	}
</style>
